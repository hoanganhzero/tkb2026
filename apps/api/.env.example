# PostgreSQL từ docker-compose.yml ở thư mục gốc
DATABASE_URL=postgres://tkb:tkb_dev_only@localhost:5432/tkb

# Redis (chưa dùng ở khung đầu tiên — dành cho BullMQ/khoá mềm)
REDIS_URL=redis://localhost:6379

# Bí mật ký JWT HS256 — ĐỔI NGAY trong môi trường thật, lưu ngoài repo
JWT_SECRET=dev-only-secret-change-me

PORT=4000
